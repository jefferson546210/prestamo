---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { supabase } from '../../../db/supabase';

const { data: config } = await supabase
  .from('configuracion')
  .select('*')
  .single();
---

<DashboardLayout title="Configuración" subtitle="Ajustes del sistema">
  <div style="max-width:640px; display:flex; flex-direction:column; gap:24px;">

    <!-- Empresa -->
    <div style="background:var(--bg-card); border-radius:16px; border:1px solid var(--border); padding:32px;">
      <h2 style="font-size:1rem; font-weight:700; color:var(--text-primary); margin-bottom:24px;">Datos de la Empresa</h2>

      <div id="error-msg" style="display:none; background:#fee2e2; color:#dc2626; padding:12px 16px; border-radius:10px; margin-bottom:16px; font-size:0.875rem;"></div>
      <div id="success-msg" style="display:none; background:#dcfce7; color:#16a34a; padding:12px 16px; border-radius:10px; margin-bottom:16px; font-size:0.875rem;">Configuración guardada correctamente.</div>

      <form id="form-config" style="display:flex; flex-direction:column; gap:18px;">

        <div>
          <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Nombre de la empresa *</label>
          <input name="nombre_empresa" required value={config?.nombre_empresa ?? ''} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
        </div>

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Teléfono</label>
            <input name="telefono" value={config?.telefono ?? ''} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
          </div>
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Correo</label>
            <input name="correo" type="email" value={config?.correo ?? ''} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
          </div>
        </div>

        <div>
          <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Dirección</label>
          <textarea name="direccion" rows={2} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; resize:vertical;">{config?.direccion ?? ''}</textarea>
        </div>

        <div>
          <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Interés por defecto (%)</label>
          <input name="interes_default" type="number" min="0" step="0.1" value={config?.interes_default ?? 0} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
        </div>

        <button type="submit" id="btn-guardar" style="background:#16a34a; color:white; padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; border:none; cursor:pointer; margin-top:8px;">
          Guardar Configuración
        </button>
      </form>
    </div>

  </div>

  <script>
    const form = document.getElementById('form-config') as HTMLFormElement;
    const errorMsg = document.getElementById('error-msg') as HTMLElement;
    const successMsg = document.getElementById('success-msg') as HTMLElement;
    const btn = document.getElementById('btn-guardar') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btn.textContent = 'Guardando...';
      btn.style.opacity = '0.7';
      errorMsg.style.display = 'none';
      successMsg.style.display = 'none';

      const fd = new FormData(form);
      const data: Record<string, any> = {};
      fd.forEach((v, k) => { data[k] = k === 'interes_default' ? Number(v) : v.toString(); });

      const res = await fetch('/api/configuracion', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        successMsg.style.display = 'block';
      } else {
        const json = await res.json();
        errorMsg.textContent = json.error || 'Error al guardar';
        errorMsg.style.display = 'block';
      }

      btn.textContent = 'Guardar Configuración';
      btn.style.opacity = '1';
    });
  </script>
</DashboardLayout>