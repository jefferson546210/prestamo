---
export const prerender = false;

import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { supabase } from '../../../../db/supabase';
import { obtenerCuotas } from '../../../../services/cuotas.service';

const { id } = Astro.params;

const { data: prestamo } = await supabase
  .from('prestamos')
  .select(`*, clientes(nombre, apellido, cedula, telefono, correo)`)
  .eq('id', id)
  .single();

const { data: pagos } = await supabase
  .from('pagos')
  .select('*')
  .eq('prestamo_id', id)
  .order('fecha_pago', { ascending: false });

const cuotas = await obtenerCuotas(id!);

const hoy = new Date();
const cuotasConEstado = cuotas.map(c => ({
  ...c,
  estado_actual: c.estado === 'pendiente' && new Date(c.fecha_vencimiento) < hoy ? 'vencido' : c.estado,
}));

const estadoStyle: Record<string, string> = {
  activo:   'background:#dbeafe; color:#2563eb;',
  pagado:   'background:#dcfce7; color:#16a34a;',
  vencido:  'background:#fee2e2; color:#dc2626;',
  pendiente:'background:#fef9c3; color:#ca8a04;',
};
---

<DashboardLayout title={`Préstamo ${prestamo?.id?.slice(0, 8) ?? ''}`}>
  {prestamo ? (
    <div style="display:flex; flex-direction:column; gap:24px;">
      <div style="display:flex; align-items:center; gap:16px;">
        <a href="/dashboard/prestamos" style="color:#94a3b8; text-decoration:none; font-size:0.875rem;">← Volver</a>
        <span style={`padding:4px 12px; border-radius:999px; font-size:0.75rem; font-weight:600; ${estadoStyle[prestamo.estado] ?? ''}`}>
          {prestamo.estado}
        </span>
      </div>

      <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
        <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; padding:24px;">
          <h2 style="font-size:0.9375rem; font-weight:700; color:#0f172a; margin-bottom:20px;">Información del Préstamo</h2>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Monto</p>
              <p style="font-size:1.125rem; font-weight:700; color:#0f172a;">RD$ {prestamo.monto.toLocaleString()}</p>
            </div>
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Monto Total</p>
              <p style="font-size:1.125rem; font-weight:700; color:#0f172a;">RD$ {prestamo.monto_total.toLocaleString()}</p>
            </div>
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Interés</p>
              <p style="font-size:1.125rem; font-weight:700; color:#0f172a;">{prestamo.interes}%</p>
            </div>
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Cuotas</p>
              <p style="font-size:1.125rem; font-weight:700; color:#0f172a;">{prestamo.cuotas}</p>
            </div>
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Saldo Restante</p>
              <p style="font-size:1.125rem; font-weight:700; color:#dc2626;">RD$ {prestamo.saldo_restante.toLocaleString()}</p>
            </div>
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Cuota Aprox.</p>
              <p style="font-size:1.125rem; font-weight:700; color:#0f172a;">RD$ {(prestamo.monto_total / prestamo.cuotas).toLocaleString()}</p>
            </div>
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Inicio</p>
              <p style="font-size:0.9375rem; font-weight:600; color:#0f172a;">{new Date(prestamo.fecha_inicio).toLocaleDateString('es-DO')}</p>
            </div>
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Vencimiento</p>
              <p style="font-size:0.9375rem; font-weight:600; color:#0f172a;">{new Date(prestamo.fecha_fin).toLocaleDateString('es-DO')}</p>
            </div>
          </div>
          {prestamo.observaciones && (
            <div style="margin-top:16px; padding-top:16px; border-top:1px solid #f1f5f9;">
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Observaciones</p>
              <p style="font-size:0.875rem; color:#475569;">{prestamo.observaciones}</p>
            </div>
          )}
        </div>

        <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; padding:24px;">
          <h2 style="font-size:0.9375rem; font-weight:700; color:#0f172a; margin-bottom:20px;">Información del Cliente</h2>
          <div style="display:flex; align-items:center; gap:12px; margin-bottom:20px;">
            <div style="width:44px; height:44px; border-radius:50%; background:#dcfce7; display:flex; align-items:center; justify-content:center; font-weight:700; color:#16a34a; font-size:1.125rem;">
              {prestamo.clientes?.nombre?.charAt(0).toUpperCase()}
            </div>
            <div>
              <p style="font-size:1rem; font-weight:700; color:#0f172a;">{prestamo.clientes?.nombre} {prestamo.clientes?.apellido}</p>
              <p style="font-size:0.8125rem; color:#94a3b8;">{prestamo.clientes?.cedula}</p>
            </div>
          </div>
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:12px;">
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Teléfono</p>
              <p style="font-size:0.875rem; font-weight:600; color:#0f172a;">{prestamo.clientes?.telefono ?? '—'}</p>
            </div>
            <div>
              <p style="font-size:0.75rem; color:#94a3b8; margin-bottom:4px;">Correo</p>
              <p style="font-size:0.875rem; font-weight:600; color:#0f172a;">{prestamo.clientes?.correo ?? '—'}</p>
            </div>
          </div>
          <div style="margin-top:20px; padding-top:20px; border-top:1px solid #f1f5f9; display:flex; gap:12px;">
            <a href={`/dashboard/clientes/${prestamo.cliente_id}`} style="flex:1; text-align:center; border:1px solid #e2e8f0; color:#475569; padding:10px; border-radius:10px; font-size:0.8125rem; font-weight:600; text-decoration:none;">
              Ver Cliente
            </a>
          </div>
        </div>
      </div>

      <!-- Plan de Cuotas -->
      <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid #f1f5f9;">
          <h2 style="font-size:0.9375rem; font-weight:700; color:#0f172a;">Plan de Cuotas</h2>
        </div>
        {cuotasConEstado.length > 0 ? (
          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse;">
              <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #f1f5f9;">
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">#</th>
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Monto</th>
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Vence</th>
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Pagado</th>
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Estado</th>
                </tr>
              </thead>
              <tbody>
                {cuotasConEstado.map(c => (
                  <tr style={`border-bottom:1px solid #f1f5f9; ${c.estado_actual === 'vencido' ? 'background:#fff5f5;' : ''}`}>
                    <td style="padding:14px 20px; font-size:0.875rem; font-weight:700; color:#0f172a;">{c.numero_cuota}</td>
                    <td style="padding:14px 20px; font-size:0.875rem; font-weight:600; color:#0f172a;">RD$ {c.monto.toLocaleString()}</td>
                    <td style="padding:14px 20px; font-size:0.875rem; color:#475569;">
                      {new Date(c.fecha_vencimiento).toLocaleDateString('es-DO')}
                    </td>
                    <td style="padding:14px 20px; font-size:0.875rem; color:#475569;">
                      {c.fecha_pago ? new Date(c.fecha_pago).toLocaleDateString('es-DO') : '—'}
                    </td>
                    <td style="padding:14px 20px;">
                      <span style={`padding:3px 10px; border-radius:999px; font-size:0.75rem; font-weight:600; ${
                        c.estado_actual === 'pagado' ? 'background:#dcfce7; color:#16a34a;' :
                        c.estado_actual === 'vencido' ? 'background:#fee2e2; color:#dc2626;' :
                        'background:#fef9c3; color:#ca8a04;'
                      }`}>
                        {c.estado_actual === 'vencido' ? 'Vencido' : c.estado_actual === 'pagado' ? 'Pagado' : 'Pendiente'}
                      </span>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div style="padding:40px; text-align:center; color:#94a3b8; font-size:0.875rem;">
            No hay cuotas generadas para este préstamo
          </div>
        )}
      </div>

      <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; overflow:hidden;">
        <div style="padding:20px 24px; border-bottom:1px solid #f1f5f9; display:flex; align-items:center; justify-content:space-between;">
          <h2 style="font-size:0.9375rem; font-weight:700; color:#0f172a;">Historial de Pagos</h2>
          <a href="/dashboard/pagos/nuevo" style="background:#16a34a; color:white; padding:8px 16px; border-radius:10px; font-size:0.8125rem; font-weight:600; text-decoration:none;">
            + Registrar Pago
          </a>
        </div>
        {pagos && pagos.length > 0 ? (
          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse;">
              <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #f1f5f9;">
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Fecha</th>
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Monto</th>
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Método</th>
                  <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Observación</th>
                </tr>
              </thead>
              <tbody>
                {pagos.map(p => (
                  <tr style="border-bottom:1px solid #f8fafc;">
                    <td style="padding:14px 20px; font-size:0.875rem; color:#475569;">{new Date(p.fecha_pago).toLocaleDateString('es-DO')}</td>
                    <td style="padding:14px 20px; font-size:0.875rem; font-weight:700; color:#16a34a;">RD$ {p.monto_pagado.toLocaleString()}</td>
                    <td style="padding:14px 20px;">
                      <span style={`padding:3px 8px; border-radius:999px; font-size:0.75rem; font-weight:600; ${p.metodo_pago === 'efectivo' ? 'background:#dcfce7; color:#16a34a;' : ''} ${p.metodo_pago === 'transferencia' ? 'background:#dbeafe; color:#2563eb;' : ''} ${p.metodo_pago === 'tarjeta' ? 'background:#f3e8ff; color:#9333ea;' : ''}`}>
                        {p.metodo_pago}
                      </span>
                    </td>
                    <td style="padding:14px 20px; font-size:0.875rem; color:#94a3b8;">{p.observacion ?? '—'}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div style="padding:40px; text-align:center; color:#94a3b8; font-size:0.875rem;">
            No hay pagos registrados para este préstamo
          </div>
        )}
      </div>
    </div>
  ) : (
    <div style="text-align:center; padding:48px;">
      <p style="color:#94a3b8; font-size:1rem;">Préstamo no encontrado</p>
      <a href="/dashboard/prestamos" style="color:#2563eb; margin-top:12px; display:inline-block;">Volver al listado</a>
    </div>
  )}
</DashboardLayout>
