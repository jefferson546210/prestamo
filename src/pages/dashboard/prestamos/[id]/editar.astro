---
export const prerender = false;

import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { supabase } from '../../../../db/supabase';
import { obtenerClientes } from '../../../../services/clientes.service';

const { id } = Astro.params;

const { data: prestamo } = await supabase
  .from('prestamos')
  .select(`*, clientes(nombre, apellido)`)
  .eq('id', id)
  .single();

const clientes = await obtenerClientes();
---

<DashboardLayout title="Editar Préstamo" subtitle={prestamo ? `RD$ ${prestamo.monto.toLocaleString()}` : 'No encontrado'}>
  {prestamo ? (
    <div style="max-width:600px;">
      <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; padding:32px;">
        <div id="error-msg" style="display:none; background:#fee2e2; border:1px solid #fecaca; color:#dc2626; padding:12px 16px; border-radius:10px; margin-bottom:20px; font-size:0.875rem;"></div>

        <form id="form-prestamo" style="display:flex; flex-direction:column; gap:20px;">
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Cliente</label>
            <select name="cliente_id" disabled style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; background:#f8fafc; color:#94a3b8;">
              <option value={prestamo.cliente_id} selected>
                {prestamo.clientes?.nombre} {prestamo.clientes?.apellido}
              </option>
            </select>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div>
              <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Monto (RD$) *</label>
              <input name="monto" type="number" min="1" required value={prestamo.monto} style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Interés (%) *</label>
              <input name="interes" type="number" min="0" step="0.1" required value={prestamo.interes} style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
            </div>
          </div>

          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div>
              <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Cuotas *</label>
              <input name="cuotas" type="number" min="1" required value={prestamo.cuotas} style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
            </div>
            <div>
              <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Estado</label>
              <select name="estado" style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; background:white;">
                <option value="activo" {prestamo.estado === 'activo' ? 'selected' : ''}>Activo</option>
                <option value="pagado" {prestamo.estado === 'pagado' ? 'selected' : ''}>Pagado</option>
                <option value="vencido" {prestamo.estado === 'vencido' ? 'selected' : ''}>Vencido</option>
              </select>
            </div>
          </div>

          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Observaciones</label>
            <textarea name="observaciones" rows={3} style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; resize:vertical;">{prestamo.observaciones ?? ''}</textarea>
          </div>

          <!-- Resumen -->
          <div id="preview" style="background:#f0fdf4; border:1px solid #bbf7d0; border-radius:10px; padding:16px;">
            <p style="font-size:0.8125rem; font-weight:600; color:#16a34a; margin-bottom:8px;">Resumen del préstamo</p>
            <div style="display:grid; grid-template-columns:1fr 1fr; gap:8px; font-size:0.875rem;">
              <span style="color:#475569;">Monto total:</span><span id="prev-total" style="font-weight:600; color:#0f172a;">RD$ {(prestamo.monto_total).toLocaleString()}</span>
              <span style="color:#475569;">Saldo restante:</span><span style="font-weight:600; color:#dc2626;">RD$ {prestamo.saldo_restante.toLocaleString()}</span>
            </div>
          </div>

          <div style="display:flex; gap:12px; padding-top:8px;">
            <button type="submit" id="btn-submit" style="flex:1; background:#16a34a; color:white; padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; border:none; cursor:pointer;">
              Guardar Cambios
            </button>
            <a href={`/dashboard/prestamos/${id}`} style="flex:1; border:1px solid #e2e8f0; color:#475569; padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; text-align:center; text-decoration:none;">
              Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  ) : (
    <div style="text-align:center; padding:48px;">
      <p style="color:#94a3b8; font-size:1rem;">Préstamo no encontrado</p>
      <a href="/dashboard/prestamos" style="color:#2563eb; margin-top:12px; display:inline-block;">Volver al listado</a>
    </div>
  )}

  <script>
    const form = document.getElementById('form-prestamo') as HTMLFormElement;
    const errorMsg = document.getElementById('error-msg') as HTMLElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
    const prevTotal = document.getElementById('prev-total') as HTMLElement;
    const id = window.location.pathname.split('/')[3];

    function calcular() {
      const monto = parseFloat((form.querySelector('[name=monto]') as HTMLInputElement).value);
      const interes = parseFloat((form.querySelector('[name=interes]') as HTMLInputElement).value);
      if (monto && interes >= 0) {
        const total = monto * (1 + interes / 100);
        prevTotal.textContent = `RD$ ${total.toLocaleString('es-DO', { minimumFractionDigits: 2 })}`;
      }
    }

    form.querySelectorAll('[name=monto],[name=interes]').forEach(el => {
      el.addEventListener('input', calcular);
    });

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnSubmit.textContent = 'Guardando...';
      btnSubmit.style.opacity = '0.7';
      errorMsg.style.display = 'none';

      const campos = ['monto', 'interes', 'cuotas', 'observaciones', 'estado'];
      const data: Record<string, any> = {};

      campos.forEach(k => {
        const el = form.querySelector(`[name=${k}]`) as HTMLInputElement | HTMLSelectElement | HTMLTextAreaElement;
        if (!el || !el.value) return;
        data[k] = ['monto', 'interes', 'cuotas'].includes(k) ? Number(el.value) : el.value;
      });

      const res = await fetch(`/api/prestamos/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.href = `/dashboard/prestamos/${id}`;
      } else {
        let msg = 'Error al guardar';
        try { const json = await res.json(); msg = json.error || msg; } catch {}
        errorMsg.textContent = msg;
        errorMsg.style.display = 'block';
        btnSubmit.textContent = 'Guardar Cambios';
        btnSubmit.style.opacity = '1';
      }
    });
  </script>
</DashboardLayout>
