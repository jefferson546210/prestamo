---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { supabase } from '../../../db/supabase';

const { data: usuarios } = await supabase
  .from('usuarios')
  .select('*')
  .order('created_at', { ascending: false });

const rolStyle: Record<string, string> = {
  admin:   'background:#dbeafe; color:#2563eb;',
  gestor:  'background:#fef9c3; color:#ca8a04;',
  cajero:  'background:#dcfce7; color:#16a34a;',
};
---

<DashboardLayout title="Usuarios" subtitle="Gestiona los usuarios del sistema">
  <div style="display:flex; flex-direction:column; gap:24px;">

    <div style="display:flex; align-items:center; justify-content:space-between;">
      <span style="background:#dbeafe; color:#2563eb; padding:4px 12px; border-radius:999px; font-size:0.75rem; font-weight:600;">
        {usuarios?.length ?? 0} usuarios
      </span>
      <button id="btn-nuevo" style="background:#16a34a; color:white; padding:10px 20px; border-radius:10px; font-size:0.875rem; font-weight:600; border:none; cursor:pointer;">
        + Nuevo Usuario
      </button>
    </div>

    <!-- Tabla -->
    <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; overflow:hidden;">
      <table style="width:100%; border-collapse:collapse;">
        <thead>
          <tr style="background:#f8fafc; border-bottom:1px solid #f1f5f9;">
            <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Nombre</th>
            <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Correo</th>
            <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Rol</th>
            <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Estado</th>
            <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase;">Acciones</th>
          </tr>
        </thead>
        <tbody>
          {!usuarios || usuarios.length === 0 ? (
            <tr>
              <td colspan={5} style="padding:48px; text-align:center; color:#94a3b8;">No hay usuarios registrados</td>
            </tr>
          ) : usuarios.map((u) => (
            <tr style="border-bottom:1px solid #f8fafc;" class="fila-usuario">
              <td style="padding:16px 20px;">
                <div style="display:flex; align-items:center; gap:12px;">
                  <div style="width:36px; height:36px; border-radius:50%; background:#dbeafe; display:flex; align-items:center; justify-content:center; font-weight:700; color:#2563eb; font-size:0.875rem;">
                    {u.nombre.charAt(0).toUpperCase()}
                  </div>
                  <span style="font-weight:600; font-size:0.875rem; color:#0f172a;">{u.nombre}</span>
                </div>
              </td>
              <td style="padding:16px 20px; font-size:0.875rem; color:#475569;">{u.correo}</td>
              <td style="padding:16px 20px;">
                <span style={`padding:4px 10px; border-radius:999px; font-size:0.75rem; font-weight:600; ${rolStyle[u.rol] ?? ''}`}>
                  {u.rol}
                </span>
              </td>
              <td style="padding:16px 20px;">
                <span style={`padding:4px 10px; border-radius:999px; font-size:0.75rem; font-weight:600; ${u.activo ? 'background:#dcfce7; color:#16a34a;' : 'background:#fee2e2; color:#dc2626;'}`}>
                  {u.activo ? 'Activo' : 'Inactivo'}
                </span>
              </td>
              <td style="padding:16px 20px;">
                <button data-id={u.id} class="btn-toggle" style={`font-size:0.8125rem; font-weight:500; background:none; border:none; cursor:pointer; padding:0; color:${u.activo ? '#dc2626' : '#16a34a'};`}>
                  {u.activo ? 'Desactivar' : 'Activar'}
                </button>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>

    <!-- Modal nuevo usuario -->
    <div id="modal" style="display:none; position:fixed; inset:0; background:rgba(0,0,0,0.4); z-index:50; align-items:center; justify-content:center;">
      <div style="background:white; border-radius:16px; padding:32px; width:100%; max-width:480px; margin:16px;">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:24px;">
          <h2 style="font-size:1.125rem; font-weight:700; color:#0f172a;">Nuevo Usuario</h2>
          <button id="btn-cerrar" style="background:none; border:none; font-size:1.25rem; color:#94a3b8; cursor:pointer;">✕</button>
        </div>

        <div id="modal-error" style="display:none; background:#fee2e2; color:#dc2626; padding:12px; border-radius:10px; margin-bottom:16px; font-size:0.875rem;"></div>

        <form id="form-usuario" style="display:flex; flex-direction:column; gap:16px;">
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Nombre *</label>
            <input name="nombre" required style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
          </div>
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Correo *</label>
            <input name="correo" type="email" required style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
          </div>
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Contraseña *</label>
            <input name="password" type="password" required style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
          </div>
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Rol *</label>
            <select name="rol" required style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; background:white;">
              <option value="">Seleccionar...</option>
              <option value="admin">Administrador</option>
              <option value="gestor">Gestor</option>
              <option value="cajero">Cajero</option>
            </select>
          </div>
          <div style="display:flex; gap:12px; padding-top:8px;">
            <button type="submit" id="btn-crear" style="flex:1; background:#16a34a; color:white; padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; border:none; cursor:pointer;">
              Crear Usuario
            </button>
            <button type="button" id="btn-cancelar" style="flex:1; border:1px solid #e2e8f0; color:#475569; padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; background:white; cursor:pointer;">
              Cancelar
            </button>
          </div>
        </form>
      </div>
    </div>

  </div>

  <script>
    const modal = document.getElementById('modal') as HTMLElement;
    const modalError = document.getElementById('modal-error') as HTMLElement;
    const formUsuario = document.getElementById('form-usuario') as HTMLFormElement;
    const btnCrear = document.getElementById('btn-crear') as HTMLButtonElement;

    document.getElementById('btn-nuevo')?.addEventListener('click', () => {
      modal.style.display = 'flex';
    });

    document.getElementById('btn-cerrar')?.addEventListener('click', () => {
      modal.style.display = 'none';
    });

    document.getElementById('btn-cancelar')?.addEventListener('click', () => {
      modal.style.display = 'none';
    });

    formUsuario.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnCrear.textContent = 'Creando...';
      btnCrear.style.opacity = '0.7';
      modalError.style.display = 'none';

      const fd = new FormData(formUsuario);
      const data: Record<string, any> = {};
      fd.forEach((v, k) => { data[k] = v.toString(); });

      const res = await fetch('/api/usuarios', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        location.reload();
      } else {
        const json = await res.json();
        modalError.textContent = json.error || 'Error al crear usuario';
        modalError.style.display = 'block';
        btnCrear.textContent = 'Crear Usuario';
        btnCrear.style.opacity = '1';
      }
    });

    document.querySelectorAll('.btn-toggle').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        const activo = (btn as HTMLElement).textContent?.trim() === 'Desactivar';
        const res = await fetch(`/api/usuarios/${id}`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ activo: !activo }),
        });
        if (res.ok) location.reload();
      });
    });

    document.querySelectorAll('.fila-usuario').forEach(fila => {
      fila.addEventListener('mouseenter', () => (fila as HTMLElement).style.background = '#f8fafc');
      fila.addEventListener('mouseleave', () => (fila as HTMLElement).style.background = 'transparent');
    });
  </script>
</DashboardLayout>