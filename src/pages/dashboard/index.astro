---
import DashboardLayout from '../../layouts/DashboardLayout.astro';
import { obtenerEstadisticasDashboard } from '../../services/dashboard.service';
import { obtenerPagosRecientes } from '../../services/pagos.service';

const stats = await obtenerEstadisticasDashboard();
const pagos = await obtenerPagosRecientes(6);
---

<DashboardLayout title="Panel Administrativo">
  <div style="display:flex; flex-direction:column; gap:24px;">
    <!-- Stat Cards -->
    <div style="display:grid; grid-template-columns:repeat(3,1fr); gap:16px;">
      <div style="background:var(--bg-card); border-radius:16px; padding:24px; position:relative; overflow:hidden; border:1px solid var(--border);">
        <div style="position:absolute; top:16px; right:16px; width:36px; height:36px; background:#dbeafe; border-radius:10px; display:flex; align-items:center; justify-content:center;">
          <svg width="16" height="16" fill="none" stroke="#2563eb" strokeWidth="2" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" d="M17 9V7a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2m2 4h10a2 2 0 002-2v-6a2 2 0 00-2-2H9a2 2 0 00-2 2v6a2 2 0 002 2zm7-5a2 2 0 11-4 0 2 2 0 014 0z"/></svg>
        </div>
        <p style="font-size:12px; font-weight:600; color:#94a3b8;">Total Prestado</p>
        <p style="font-size:28px; font-weight:800; color:var(--text-primary); margin-top:8px;">RD$ {stats.totalPrestado.toLocaleString()}</p>
      </div>
      <div style="background:var(--bg-card); border-radius:16px; padding:24px; position:relative; overflow:hidden; border:1px solid var(--border);">
        <div style="position:absolute; top:16px; right:16px; width:36px; height:36px; background:#dcfce7; border-radius:10px; display:flex; align-items:center; justify-content:center;">
          <svg width="16" height="16" fill="none" stroke="#16a34a" strokeWidth="2" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"/></svg>
        </div>
        <p style="font-size:12px; font-weight:600; color:#94a3b8;">Préstamos Activos</p>
        <p style="font-size:28px; font-weight:800; color:var(--text-primary); margin-top:8px;">{stats.prestamosActivos}</p>
        <p style="font-size:13px; color:#16a34a; font-weight:600; margin-top:4px;">Tasa cumplimiento {stats.tasaCumplimiento}%</p>
      </div>
      <div style="background:var(--bg-card); border-radius:16px; padding:24px; position:relative; overflow:hidden; border:1px solid var(--border);">
        <div style="position:absolute; top:16px; right:16px; width:36px; height:36px; background:#f3e8ff; border-radius:10px; display:flex; align-items:center; justify-content:center;">
          <svg width="16" height="16" fill="none" stroke="#9333ea" strokeWidth="2" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z"/></svg>
        </div>
        <p style="font-size:12px; font-weight:600; color:#94a3b8;">Clientes Registrados</p>
        <p style="font-size:28px; font-weight:800; color:var(--text-primary); margin-top:8px;">{stats.totalClientes}</p>
        <p style="font-size:13px; color:#9333ea; font-weight:600; margin-top:4px;">+{stats.nuevosClientesMes} nuevos este mes</p>
      </div>
    </div>

    <!-- Bottom row -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
      <!-- Estado de Préstamos -->
      <div style="background:var(--bg-card); border-radius:16px; padding:24px; border:1px solid var(--border);">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
          <h2 style="font-size:15px; font-weight:700; color:var(--text-primary);">Estado de Préstamos</h2>
          <a href="/dashboard/prestamos" style="font-size:13px; font-weight:600; color:#2563eb; text-decoration:none;">ver más →</a>
        </div>
        <div style="display:flex; flex-direction:column; gap:12px; margin-bottom:20px;">
          {[
            { label: 'Activos', count: stats.prestamosActivos, color: '#2563eb', pct: stats.totalPrestamosCount > 0 ? Math.round(stats.prestamosActivos / stats.totalPrestamosCount * 100) : 0 },
            { label: 'Pagados', count: stats.prestamosPagados, color: '#16a34a', pct: stats.totalPrestamosCount > 0 ? Math.round(stats.prestamosPagados / stats.totalPrestamosCount * 100) : 0 },
            { label: 'Vencidos', count: stats.prestamosVencidos, color: '#dc2626', pct: stats.totalPrestamosCount > 0 ? Math.round(stats.prestamosVencidos / stats.totalPrestamosCount * 100) : 0 },
          ].map(item => (
            <div>
              <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:4px;">
                <div style="display:flex; align-items:center; gap:8px;">
                  <span style={'width:8px; height:8px; border-radius:50%; background:' + item.color + '; display:inline-block;'}></span>
                  <span style="font-size:13px; color:var(--text-secondary);">{item.label}</span>
                </div>
                <span style="font-size:13px; font-weight:700; color:var(--text-primary);">{item.count}</span>
              </div>
              <div style="background:var(--border); border-radius:999px; height:6px;">
                <div style={'height:6px; border-radius:999px; background:' + item.color + '; width:' + item.pct + '%;'}></div>
              </div>
            </div>
          ))}
        </div>
      </div>

      <!-- Últimos Pagos -->
      <div style="background:var(--bg-card); border-radius:16px; padding:24px; border:1px solid var(--border);">
        <div style="display:flex; align-items:center; justify-content:space-between; margin-bottom:20px;">
          <h2 style="font-size:15px; font-weight:700; color:var(--text-primary);">Últimos Pagos</h2>
          <a href="/dashboard/pagos" style="font-size:13px; font-weight:600; color:#2563eb; text-decoration:none;">ver más →</a>
        </div>

        {pagos.length === 0 ? (
          <p style="text-align:center; color:#94a3b8; padding:24px 0; font-size:14px;">No hay pagos registrados</p>
        ) : (
          <div style="display:flex; flex-direction:column;">
            <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:8px; padding:8px 0; border-bottom:1px solid var(--border); margin-bottom:4px;">
              <span style="font-size:10px; font-weight:700; color:#94a3b8; text-transform:uppercase;">Préstamo</span>
              <span style="font-size:10px; font-weight:700; color:#94a3b8; text-transform:uppercase;">Monto</span>
              <span style="font-size:10px; font-weight:700; color:#94a3b8; text-transform:uppercase;">Método</span>
            </div>
            {pagos.map(pago => (
              <div style="display:grid; grid-template-columns:2fr 1fr 1fr; gap:8px; align-items:center; padding:12px 0; border-bottom:1px solid var(--border);">
                <span style="font-size:12px; font-weight:600; color:var(--text-primary); font-family:monospace;">{pago.prestamo_id?.slice(0, 8)}...</span>
                <span style="font-size:13px; font-weight:700; color:#16a34a;">RD$ {pago.monto_pagado.toLocaleString()}</span>
                <span style={{
                  fontSize: 11, fontWeight: 600, padding: '3px 8px', borderRadius: 999, textAlign: 'center',
                  background: pago.metodo_pago === 'efectivo' ? '#dcfce7' : pago.metodo_pago === 'transferencia' ? '#dbeafe' : '#f3e8ff',
                  color: pago.metodo_pago === 'efectivo' ? '#16a34a' : pago.metodo_pago === 'transferencia' ? '#2563eb' : '#9333ea',
                }}>
                  {pago.metodo_pago}
                </span>
              </div>
            ))}
          </div>
        )}
      </div>
    </div>

    <!-- Charts row -->
    <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
      <!-- Pie chart: Estado de Préstamos -->
      <div style="background:var(--bg-card); border-radius:16px; padding:24px; border:1px solid var(--border);">
        <h2 style="font-size:15px; font-weight:700; color:var(--text-primary); margin-bottom:16px;">Distribución de Préstamos</h2>
        <canvas id="chartPrestamos" style="max-height:220px; max-width:220px; margin:0 auto;"></canvas>
      </div>
      <!-- Bar chart: Pagos por mes -->
      <div style="background:var(--bg-card); border-radius:16px; padding:24px; border:1px solid var(--border);">
        <h2 style="font-size:15px; font-weight:700; color:var(--text-primary); margin-bottom:16px;">Pagos por Mes (RD$)</h2>
        <canvas id="chartPagos" style="max-height:220px;"></canvas>
      </div>
    </div>

    <!-- Próximos vencimientos -->
    {stats.proximosVencimientos.length > 0 && (
      <div style="background:var(--bg-card); border-radius:16px; padding:24px; border:1px solid var(--border);">
        <h2 style="font-size:15px; font-weight:700; color:var(--text-primary); margin-bottom:16px;">Próximos Vencimientos</h2>
        <div style="display:grid; grid-template-columns:repeat(auto-fill, minmax(200px, 1fr)); gap:12px;">
          {stats.proximosVencimientos.map(v => (
            <div style="background:var(--table-header-bg); border-radius:12px; padding:16px; border:1px solid var(--border);">
              <p style="font-size:13px; font-weight:600; color:var(--text-primary);">{v.cliente}</p>
              <p style="font-size:12px; color:var(--text-muted); margin-top:4px;">RD$ {v.monto.toLocaleString()}</p>
              <p style={'font-size:13px; font-weight:700; margin-top:8px; ' + (v.diasRestante <= 3 ? 'color:#dc2626' : 'color:#ca8a04')}>
                {v.diasRestante <= 1 ? 'Vence hoy' : v.diasRestante + ' días'}
              </p>
            </div>
          ))}
        </div>
      </div>
    )}
  </div>

  <script id="data-dashboard" type="application/json">{
    "pagosPorMes": [${stats.pagosPorMes.map(p => `{"mes":"${p.mes}","total":${p.total}}`).join(',')}],
    "prestamosPorEstado": [${stats.prestamosPorEstado.map(e => `{"estado":"${e.estado}","count":${e.count},"color":"${e.color}"}`).join(',')}]
  }</script>

  <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.7/dist/chart.umd.min.js" data-astro-rerun></script>
  <script data-astro-rerun>
    (() => {
      const data = JSON.parse(document.getElementById('data-dashboard').textContent);

      if (data.prestamosPorEstado.length > 0 && document.getElementById('chartPrestamos')) {
        new Chart(document.getElementById('chartPrestamos'), {
          type: 'doughnut',
          data: {
            labels: data.prestamosPorEstado.map(e => e.estado),
            datasets: [{ data: data.prestamosPorEstado.map(e => e.count), backgroundColor: data.prestamosPorEstado.map(e => e.color), borderWidth: 0 }]
          },
          options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { position: 'bottom', labels: { padding: 12, font: { size: 11 }, usePointStyle: true } } } }
        });
      }

      if (data.pagosPorMes.some(p => p.total > 0) && document.getElementById('chartPagos')) {
        new Chart(document.getElementById('chartPagos'), {
          type: 'bar',
          data: {
            labels: data.pagosPorMes.map(p => p.mes),
            datasets: [{ label: 'RD$', data: data.pagosPorMes.map(p => p.total), backgroundColor: '#2563eb', borderRadius: 6, borderSkipped: false }]
          },
          options: { responsive: true, maintainAspectRatio: true, plugins: { legend: { display: false } }, scales: { y: { beginAtZero: true, ticks: { callback: v => 'RD$ ' + v.toLocaleString(), font: { size: 10 } }, grid: { color: '#f1f5f9' } }, x: { grid: { display: false }, ticks: { font: { size: 10 } } } } }
        });
      }
    })();
  </script>
</DashboardLayout>
