---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
import { obtenerClientes } from '../../../services/clientes.service';

const clientes = await obtenerClientes();
---

<DashboardLayout title="Clientes" subtitle="Gestiona los clientes registrados">
  <div style="display:flex; flex-direction:column; gap:24px;">

    <!-- Header -->
    <div style="display:flex; align-items:center; justify-content:space-between;">
      <div style="display:flex; gap:8px;">
        <span style="background:#dcfce7; color:#16a34a; padding:4px 12px; border-radius:999px; font-size:0.75rem; font-weight:600;">
          {clientes.length} clientes
        </span>
      </div>
      <div style="display:flex; gap:8px;">
        <button id="btnExportClientes" style="display:flex; align-items:center; gap:6px; background:white; color:#475569; padding:10px 16px; border-radius:10px; font-size:0.875rem; font-weight:600; border:1px solid #e2e8f0; cursor:pointer;">
          <svg width="14" height="14" fill="none" stroke="currentColor" strokeWidth="2" viewBox="0 0 24 24"><path strokeLinecap="round" strokeLinejoin="round" d="M12 10v6m0 0l-3-3m3 3l3-3m2 8H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"/></svg>
          Exportar
        </button>
        <a href="/dashboard/clientes/nuevo" style="display:flex; align-items:center; gap:8px; background:#16a34a; color:white; padding:10px 20px; border-radius:10px; font-size:0.875rem; font-weight:600; text-decoration:none;">
          + Nuevo Cliente
        </a>
      </div>
    </div>

    <!-- Tabla -->
    <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; overflow:hidden;">
      <div style="overflow-x:auto;">
        <table style="width:100%; border-collapse:collapse;">
          <thead>
            <tr style="background:#f8fafc; border-bottom:1px solid #f1f5f9;">
              <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:0.05em;">Cliente</th>
              <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:0.05em;">Cédula</th>
              <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:0.05em;">Teléfono</th>
              <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:0.05em;">Correo</th>
              <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:0.05em;">Estado</th>
              <th style="padding:12px 20px; text-align:left; font-size:0.75rem; font-weight:600; color:#94a3b8; text-transform:uppercase; letter-spacing:0.05em;">Acciones</th>
            </tr>
          </thead>
          <tbody>
            {clientes.length === 0 ? (
              <tr>
                <td colspan={6} style="padding:48px; text-align:center; color:#94a3b8; font-size:0.875rem;">
                  No hay clientes registrados
                </td>
              </tr>
            ) : clientes.map((c) => (
              <tr style="border-bottom:1px solid #f8fafc;" class="fila-cliente">
                <td style="padding:16px 20px;">
                  <div style="display:flex; align-items:center; gap:12px;">
                    <div style={`width:36px; height:36px; border-radius:50%; background:#dcfce7; display:flex; align-items:center; justify-content:center; font-weight:700; font-size:0.875rem; color:#16a34a; flex-shrink:0;`}>
                      {c.nombre.charAt(0).toUpperCase()}
                    </div>
                    <div>
                      <div style="font-weight:600; font-size:0.875rem; color:#0f172a;">{c.nombre} {c.apellido}</div>
                    </div>
                  </div>
                </td>
                <td style="padding:16px 20px; font-size:0.875rem; color:#475569;">{c.cedula}</td>
                <td style="padding:16px 20px; font-size:0.875rem; color:#475569;">{c.telefono}</td>
                <td style="padding:16px 20px; font-size:0.875rem; color:#475569;">{c.correo ?? '—'}</td>
                <td style="padding:16px 20px;">
                  <span style={`padding:4px 10px; border-radius:999px; font-size:0.75rem; font-weight:600; ${c.activo ? 'background:#dcfce7; color:#16a34a;' : 'background:#fee2e2; color:#dc2626;'}`}>
                    {c.activo ? 'Activo' : 'Inactivo'}
                  </span>
                </td>
                <td style="padding:16px 20px;">
                  <div style="display:flex; gap:8px;">
                    <a href={`/dashboard/clientes/${c.id}`} style="font-size:0.8125rem; color:#2563eb; font-weight:500; text-decoration:none;">Ver</a>
                    <a href={`/dashboard/clientes/${c.id}/editar`} style="font-size:0.8125rem; color:#16a34a; font-weight:500; text-decoration:none;">Editar</a>
                    <button data-id={c.id} class="btn-eliminar" style="font-size:0.8125rem; color:#dc2626; font-weight:500; background:none; border:none; cursor:pointer; padding:0;">Eliminar</button>
                  </div>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>
    </div>
  </div>

  <script>
    document.querySelectorAll('.btn-eliminar').forEach(btn => {
      btn.addEventListener('click', async () => {
        const id = (btn as HTMLElement).dataset.id;
        const ok = await window.confirmAction('Eliminar cliente', '¿Estás seguro de eliminar este cliente? Esta acción no se puede deshacer.');
        if (!ok) return;
        const res = await fetch(`/api/clientes/${id}`, { method: 'DELETE' });
        if (res.ok) { window.toast('Cliente eliminado correctamente'); location.reload(); }
        else window.toast('Error al eliminar el cliente', 'error');
      });
    });

    document.querySelectorAll('.fila-cliente').forEach(fila => {
      fila.addEventListener('mouseenter', () => (fila as HTMLElement).style.background = '#f8fafc');
      fila.addEventListener('mouseleave', () => (fila as HTMLElement).style.background = 'transparent');
    });

    document.getElementById('btnExportClientes')?.addEventListener('click', () => {
      const rows = Array.from(document.querySelectorAll('.fila-cliente'));
      const csv = [['Cliente','Cédula','Teléfono','Correo','Estado'].join(',')];
      rows.forEach(r => {
        const cells = r.querySelectorAll('td');
        const nombre = cells[0]?.querySelector('div > div')?.textContent?.trim() || '';
        const cedula = cells[1]?.textContent?.trim() || '';
        const tel = cells[2]?.textContent?.trim() || '';
        const correo = cells[3]?.textContent?.trim() || '';
        const estado = cells[4]?.querySelector('span')?.textContent?.trim() || '';
        csv.push(`"${nombre}","${cedula}","${tel}","${correo}","${estado}"`);
      });
      const blob = new Blob([csv.join('\n')], { type: 'text/csv;charset=utf-8;' });
      const a = document.createElement('a'); a.href = URL.createObjectURL(blob); a.download = 'clientes.csv'; a.click();
      URL.revokeObjectURL(a.href);
    });
  </script>
</DashboardLayout>