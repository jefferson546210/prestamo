---
export const prerender = false;

import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { supabase } from '../../../../db/supabase';
import type { Prestamo } from '../../../../types/prestamo';

const { id } = Astro.params;

const [{ data: cliente }, { data: prestamos }] = await Promise.all([
  supabase.from('clientes').select('*').eq('id', id).single(),
  supabase.from('prestamos').select('*').eq('cliente_id', id).order('created_at', { ascending: false }),
]);

const estadoStyle: Record<string, string> = {
  activo:   'background:#dbeafe; color:#2563eb;',
  pagado:   'background:#dcfce7; color:#16a34a;',
  vencido:  'background:#fee2e2; color:#dc2626;',
  pendiente:'background:#fef9c3; color:#ca8a04;',
};
---

<DashboardLayout title={cliente ? `${cliente.nombre} ${cliente.apellido}` : 'Cliente'}>
  {cliente ? (
    <div style="display:flex; flex-direction:column; gap:24px;">
      <div style="display:flex; align-items:center; justify-content:space-between;">
        <div style="display:flex; align-items:center; gap:16px;">
          <a href="/dashboard/clientes" style="color:#94a3b8; text-decoration:none; font-size:14px;">← Volver</a>
          <div>
            <h1 style="font-size:24px; font-weight:800; color:#0f172a;">{cliente.nombre} {cliente.apellido}</h1>
            <p style="font-size:13px; color:#64748b;">Detalles del cliente</p>
          </div>
        </div>
        <div style="display:flex; gap:8px;">
          <span style={`padding:4px 12px; border-radius:999px; font-size:12px; font-weight:600; ${cliente.activo ? 'background:#dcfce7; color:#16a34a;' : 'background:#fee2e2; color:#dc2626;'}`}>
            {cliente.activo ? 'Activo' : 'Inactivo'}
          </span>
        </div>
      </div>

      <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; padding:24px;">
        <h2 style="font-size:15px; font-weight:700; color:#0f172a; margin-bottom:20px;">Información Personal</h2>
        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div>
            <p style="font-size:12px; color:#94a3b8;">Nombre completo</p>
            <p style="font-size:14px; font-weight:600; color:#0f172a; margin-top:4px;">{cliente.nombre} {cliente.apellido}</p>
          </div>
          <div>
            <p style="font-size:12px; color:#94a3b8;">Cédula</p>
            <p style="font-size:14px; font-weight:600; color:#0f172a; margin-top:4px;">{cliente.cedula}</p>
          </div>
          <div>
            <p style="font-size:12px; color:#94a3b8;">Teléfono</p>
            <p style="font-size:14px; font-weight:600; color:#0f172a; margin-top:4px;">{cliente.telefono}</p>
          </div>
          <div>
            <p style="font-size:12px; color:#94a3b8;">Correo</p>
            <p style="font-size:14px; font-weight:600; color:#0f172a; margin-top:4px;">{cliente.correo ?? 'No registrado'}</p>
          </div>
          <div style="grid-column:span 2;">
            <p style="font-size:12px; color:#94a3b8;">Dirección</p>
            <p style="font-size:14px; font-weight:600; color:#0f172a; margin-top:4px;">{cliente.direccion ?? 'No registrada'}</p>
          </div>
        </div>
      </div>

      <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; overflow:hidden;">
        <div style="padding:16px 24px; border-bottom:1px solid #f1f5f9;">
          <h2 style="font-size:15px; font-weight:700; color:#0f172a;">Préstamos del Cliente</h2>
        </div>
        {prestamos && prestamos.length > 0 ? (
          <div style="overflow-x:auto;">
            <table style="width:100%; border-collapse:collapse;">
              <thead>
                <tr style="background:#f8fafc; border-bottom:1px solid #f1f5f9;">
                  <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase;">ID</th>
                  <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase;">Monto</th>
                  <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase;">Saldo</th>
                  <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase;">Estado</th>
                  <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase;">Fecha</th>
                  <th style="padding:12px 20px; text-align:left; font-size:11px; font-weight:600; color:#94a3b8; text-transform:uppercase;">Acción</th>
                </tr>
              </thead>
              <tbody>
                {prestamos.map((p: Prestamo) => (
                  <tr style="border-bottom:1px solid #f8fafc;">
                    <td style="padding:14px 20px; font-size:13px; color:#64748b; font-family:monospace;">{p.id.slice(0, 8)}</td>
                    <td style="padding:14px 20px; font-size:14px; font-weight:700; color:#0f172a;">RD$ {p.monto.toLocaleString()}</td>
                    <td style="padding:14px 20px; font-size:14px; font-weight:600; color:#dc2626;">RD$ {p.saldo_restante.toLocaleString()}</td>
                    <td style="padding:14px 20px;">
                      <span style={`padding:4px 10px; border-radius:999px; font-size:11px; font-weight:600; ${estadoStyle[p.estado] ?? ''}`}>
                        {p.estado}
                      </span>
                    </td>
                    <td style="padding:14px 20px; font-size:13px; color:#475569;">
                      {new Date(p.fecha_inicio).toLocaleDateString('es-DO')}
                    </td>
                    <td style="padding:14px 20px;">
                      <a href={`/dashboard/prestamos/${p.id}`} style="font-size:13px; color:#2563eb; font-weight:500; text-decoration:none;">Ver</a>
                    </td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        ) : (
          <div style="padding:40px; text-align:center; color:#94a3b8; font-size:14px;">
            No tiene préstamos registrados
          </div>
        )}
      </div>
    </div>
  ) : (
    <div style="text-align:center; padding:48px;">
      <p style="color:#94a3b8; font-size:16px;">Cliente no encontrado</p>
      <a href="/dashboard/clientes" style="color:#2563eb; margin-top:12px; display:inline-block;">Volver al listado</a>
    </div>
  )}
</DashboardLayout>
