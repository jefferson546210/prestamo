---
export const prerender = false;

import DashboardLayout from '../../../../layouts/DashboardLayout.astro';
import { supabase } from '../../../../db/supabase';

const { id } = Astro.params;

const { data: cliente } = await supabase
  .from('clientes')
  .select('*')
  .eq('id', id)
  .single();
---

<DashboardLayout title="Editar Cliente" subtitle={cliente ? `${cliente.nombre} ${cliente.apellido}` : 'Cliente no encontrado'}>
  {cliente ? (
    <div style="max-width:600px; margin:0 auto;">
      <div style="background:var(--bg-card); border-radius:16px; border:1px solid var(--border); padding:32px;">
        <div id="error-msg" style="display:none; background:#fee2e2; border:1px solid #fecaca; color:#dc2626; padding:12px 16px; border-radius:10px; margin-bottom:20px; font-size:0.875rem;"></div>

        <form id="form-cliente" style="display:flex; flex-direction:column; gap:20px;">
          <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
            <div>
              <label style="display:block; font-size:0.8125rem; font-weight:600; color:var(--label-color); margin-bottom:6px;">Nombre *</label>
              <input name="nombre" required value={cliente.nombre} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; background:var(--input-bg); color:var(--input-text);" />
            </div>
            <div>
              <label style="display:block; font-size:0.8125rem; font-weight:600; color:var(--label-color); margin-bottom:6px;">Apellido *</label>
              <input name="apellido" required value={cliente.apellido} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; background:var(--input-bg); color:var(--input-text);" />
            </div>
          </div>

          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:var(--label-color); margin-bottom:6px;">Cédula *</label>
            <input name="cedula" required value={cliente.cedula} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; background:var(--input-bg); color:var(--input-text);" />
          </div>

          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:var(--label-color); margin-bottom:6px;">Teléfono *</label>
            <input name="telefono" required value={cliente.telefono} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; background:var(--input-bg); color:var(--input-text);" />
          </div>

          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:var(--label-color); margin-bottom:6px;">Correo</label>
            <input name="correo" type="email" value={cliente.correo ?? ''} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; background:var(--input-bg); color:var(--input-text);" />
          </div>

          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:var(--label-color); margin-bottom:6px;">Dirección</label>
            <textarea name="direccion" rows={3} style="width:100%; border:1px solid var(--input-border); border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; resize:vertical; background:var(--input-bg); color:var(--input-text);">{cliente.direccion ?? ''}</textarea>
          </div>

          <div style="display:flex; gap:12px; padding-top:8px;">
            <button type="submit" id="btn-submit" style="flex:1; background:#16a34a; color:white; padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; border:none; cursor:pointer;">
              Guardar Cambios
            </button>
            <a href={`/dashboard/clientes/${id}`} style="flex:1; border:1px solid var(--border); color:var(--text-secondary); padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; text-align:center; text-decoration:none;">
              Cancelar
            </a>
          </div>
        </form>
      </div>
    </div>
  ) : (
    <div style="text-align:center; padding:48px;">
      <p style="color:#94a3b8; font-size:1rem;">Cliente no encontrado</p>
      <a href="/dashboard/clientes" style="color:#2563eb; margin-top:12px; display:inline-block;">Volver al listado</a>
    </div>
  )}

  <script>
    const form = document.getElementById('form-cliente') as HTMLFormElement;
    const errorMsg = document.getElementById('error-msg') as HTMLElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;
    const id = window.location.pathname.split('/')[3];

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnSubmit.textContent = 'Guardando...';
      btnSubmit.style.opacity = '0.7';
      errorMsg.style.display = 'none';

      const fd = new FormData(form);
      const data: Record<string, string> = {};
      fd.forEach((v, k) => { if (v) data[k] = v.toString(); });

      const res = await fetch(`/api/clientes/${id}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.href = `/dashboard/clientes/${id}`;
      } else {
        const json = await res.json();
        errorMsg.textContent = json.error || 'Error al guardar';
        errorMsg.style.display = 'block';
        btnSubmit.textContent = 'Guardar Cambios';
        btnSubmit.style.opacity = '1';
      }
    });
  </script>
</DashboardLayout>
