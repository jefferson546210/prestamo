---
import DashboardLayout from '../../../layouts/DashboardLayout.astro';
---

<DashboardLayout title="Nuevo Cliente" subtitle="Registra un nuevo cliente">
  <div style="max-width:600px;">
    <div style="background:white; border-radius:16px; border:1px solid #f1f5f9; padding:32px;">

      <div id="error-msg" style="display:none; background:#fee2e2; border:1px solid #fecaca; color:#dc2626; padding:12px 16px; border-radius:10px; margin-bottom:20px; font-size:0.875rem;"></div>

      <form id="form-cliente" style="display:flex; flex-direction:column; gap:20px;">

        <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Nombre *</label>
            <input name="nombre" required style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
          </div>
          <div>
            <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Apellido *</label>
            <input name="apellido" required style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
          </div>
        </div>

        <div>
          <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Cédula *</label>
          <input name="cedula" required placeholder="000-0000000-0" style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
        </div>

        <div>
          <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Teléfono *</label>
          <input name="telefono" required placeholder="809-000-0000" style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
        </div>

        <div>
          <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Correo</label>
          <input name="correo" type="email" style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none;" />
        </div>

        <div>
          <label style="display:block; font-size:0.8125rem; font-weight:600; color:#374151; margin-bottom:6px;">Dirección</label>
          <textarea name="direccion" rows={3} style="width:100%; border:1px solid #e2e8f0; border-radius:10px; padding:10px 14px; font-size:0.875rem; outline:none; resize:vertical;"></textarea>
        </div>

        <div style="display:flex; gap:12px; padding-top:8px;">
          <button type="submit" id="btn-submit" style="flex:1; background:#16a34a; color:white; padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; border:none; cursor:pointer;">
            Guardar Cliente
          </button>
          <a href="/dashboard/clientes" style="flex:1; border:1px solid #e2e8f0; color:#475569; padding:12px; border-radius:10px; font-size:0.875rem; font-weight:600; text-align:center; text-decoration:none;">
            Cancelar
          </a>
        </div>
      </form>
    </div>
  </div>

  <script>
    const form = document.getElementById('form-cliente') as HTMLFormElement;
    const errorMsg = document.getElementById('error-msg') as HTMLElement;
    const btnSubmit = document.getElementById('btn-submit') as HTMLButtonElement;

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      btnSubmit.textContent = 'Guardando...';
      btnSubmit.style.opacity = '0.7';
      errorMsg.style.display = 'none';

      const fd = new FormData(form);
      const data: Record<string, string> = {};
      fd.forEach((v, k) => { if (v) data[k] = v.toString(); });

      const res = await fetch('/api/clientes', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      if (res.ok) {
        window.location.href = '/dashboard/clientes';
      } else {
        const json = await res.json();
        errorMsg.textContent = json.error || 'Error al guardar';
        errorMsg.style.display = 'block';
        btnSubmit.textContent = 'Guardar Cliente';
        btnSubmit.style.opacity = '1';
      }
    });
  </script>
</DashboardLayout>